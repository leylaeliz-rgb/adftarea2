{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_Sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          NombreParada = trim(NombreParada),",
				"          Zona = upper(trim(Zona)),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 derive(Latitud = toDecimal(trim(Latitud)),",
				"          Longitud = toDecimal(trim(Longitud))) ~> derivedColumn2",
				"derivedColumn2 derive(AnioFuente = toInteger(trim(AnioFuente)),",
				"          VigenciaDesde = iif(\r",
				"    regexMatch(trim(VigenciaDesde), '^[0-9]{5}$'),\r",
				"    addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(VigenciaDesde))),\r",
				"    toDate(replace(trim(VigenciaDesde), '/', '-'), 'yyyy-MM-dd')\r",
				"),",
				"          VigenciaHasta = iif(\r",
				"    regexMatch(trim(VigenciaHasta), '^[0-9]{5}$'),\r",
				"    addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(VigenciaHasta))),\r",
				"    toDate(replace(trim(VigenciaHasta), '/', '-'), 'yyyy-MM-dd')\r",
				")) ~> derivedColumn3",
				"derivedColumn3 derive(CodigoPublicado = iif(isNull(CodigoPublicado) || trim(CodigoPublicado) == '', ParadaHistoricaId, trim(CodigoPublicado)),",
				"          NombreParada = iif(\r",
				"    isNull(ParadaHistoricaId) || trim(toString(ParadaHistoricaId)) == '',\r",
				"    'PARADA SIN ID',\r",
				"    iif(\r",
				"        isNull(NombreParada) || trim(toString(NombreParada)) == '',\r",
				"        concat('Parada ', trim(toString(ParadaHistoricaId))),\r",
				"        trim(toString(NombreParada))\r",
				"    )\r",
				"),",
				"          Zona = iif(isNull(Zona) || trim(Zona) == '', 'SIN ZONA', upper(trim(Zona))),",
				"          Estado = iif(isNull(Estado) || trim(Estado) == '', 'NO ESPECIFICADO', upper(trim(Estado))),",
				"          ParadaHistoricaId = !isNull(ParadaHistoricaId) && trim(ParadaHistoricaId) != '') ~> derivedColumn5",
				"derivedColumn5 filter(!isNull(AnioFuente)",
				"&& !isNull(ParadaHistoricaId)",
				"&& !isNull(CodigoPublicado)",
				"&& trim(CodigoPublicado) != ''",
				"&& !isNull(NombreParada)",
				"&& trim(NombreParada) != ''",
				"&& !isNull(Zona)",
				"&& trim(Zona) != ''",
				"&& !isNull(Latitud)",
				"&& !isNull(Longitud)",
				"&& !isNull(VigenciaDesde)",
				"&& !isNull(VigenciaHasta)",
				"&& !isNull(Estado)",
				"&& trim(Estado) != '') ~> filter2",
				"filter2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ParadaHistoricaId = NombreParada,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}