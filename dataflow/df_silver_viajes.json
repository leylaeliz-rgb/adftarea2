{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = trim(ViajeId),",
				"          AnioFuente = trim(AnioFuente),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          VehiculoId = upper(trim(VehiculoId)),",
				"          FechaServicio = trim(FechaServicio),",
				"          HoraProgramada = trim(HoraProgramada),",
				"          HoraSalida = trim(HoraSalida),",
				"          HoraLlegada = trim(HoraLlegada),",
				"          ValidacionesTarjeta = trim(ValidacionesTarjeta),",
				"          KmRecorridos = trim(KmRecorridos),",
				"          EstadoViaje = upper(trim(EstadoViaje))) ~> derivedColumn1",
				"derivedColumn1 derive(RutaHistoricaId = concat('R-', lpad(replace(replace(replace(RutaHistoricaId, 'RUTA', ''), 'R-', ''), ' ', ''), 2, '0')),",
				"          VehiculoId = concat('V-', lpad(replace(VehiculoId, 'V-', ''), 3, '0'))) ~> derivedColumn2",
				"derivedColumn2 derive(FechaServicio = coalesce(toDate(FechaServicio, 'dd/MM/yyyy'), toDate(FechaServicio, 'yyyy-MM-dd')),",
				"          HoraProgramada = iif(length(HoraProgramada) == 5, concat(HoraProgramada, ':00'), HoraProgramada),",
				"          HoraSalida = iif(length(HoraSalida) == 5, concat(HoraSalida, ':00'), HoraSalida),",
				"          HoraLlegada = iif(length(HoraLlegada) == 5, concat(HoraLlegada, ':00'), HoraLlegada),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          KmRecorridos = toDecimal(replace(KmRecorridos, ',', '.'), 8, 1),",
				"          AnioFuente = toInteger(AnioFuente)) ~> derivedColumn3",
				"derivedColumn3 filter(!isNull(AnioFuente) && !isNull(ViajeId) && !isNull(RutaHistoricaId) && !isNull(VehiculoId) && !isNull(FechaServicio) && !isNull(HoraProgramada) && !isNull(HoraSalida) && !isNull(HoraLlegada) && !isNull(ValidacionesTarjeta) && !isNull(KmRecorridos) && !isNull(EstadoViaje) && ViajeId != '' && EstadoViaje != '') ~> filter1",
				"filter1 aggregate(groupBy(AnioFuente,",
				"          ViajeId),",
				"     RutaHistoricaId = first(RutaHistoricaId),",
				"          VehiculoId = first(VehiculoId),",
				"          FechaServicio = first(FechaServicio),",
				"          HoraProgramada = first(HoraProgramada),",
				"          HoraSalida = first(HoraSalida),",
				"          HoraLlegada = first(HoraLlegada),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          KmRecorridos = first(KmRecorridos),",
				"          EstadoViaje = first(EstadoViaje)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje = AnioFuente",
				"     )) ~> sink1"
			]
		}
	}
}