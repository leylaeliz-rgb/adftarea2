{
	"name": "df_silver_incidentes_ruta",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidente_ruta_Sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(AnioFuente = trim(AnioFuente),",
				"          IncidenteId = trim(IncidenteId),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          EsPrincipal = trim(EsPrincipal)) ~> derivedColumn1",
				"derivedColumn1 derive(RutaHistoricaId = iif(upper(right(trim(RutaHistoricaId), 2)) == '-N', concat(left(trim(RutaHistoricaId), length(trim(RutaHistoricaId)) - 1), 'NEW'), trim(RutaHistoricaId))) ~> derivedColumn2",
				"derivedColumn2 derive(AnioFuente = toInteger(AnioFuente),",
				"          EsPrincipal = iif(in(['1','true','t','si','sí','s','y','yes'], lower(EsPrincipal)), 1, 0)) ~> derivedColumn3",
				"derivedColumn3 filter(!isNull(AnioFuente) && !isNull(IncidenteId) && !isNull(RutaHistoricaId) && IncidenteId != '' && RutaHistoricaId != '') ~> filter1",
				"filter1 aggregate(groupBy(AnioFuente,",
				"          IncidenteId,",
				"          RutaHistoricaId),",
				"     EsPrincipal = max(EsPrincipal)) ~> aggregate1",
				"aggregate1 derive(EsPrincipal = EsPrincipal == 1) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal",
				"     )) ~> sink1"
			]
		}
	}
}