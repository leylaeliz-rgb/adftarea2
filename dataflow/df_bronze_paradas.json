{
	"name": "df_bronze_paradas",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_paradas_csv",
						"type": "DatasetReference"
					},
					"name": "CSV"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "SQL"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_2022_xls",
						"type": "DatasetReference"
					},
					"name": "XLS2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_paradas_2023_xls",
						"type": "DatasetReference"
					},
					"name": "XLS2023"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_Sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				},
				{
					"name": "union2"
				},
				{
					"name": "union3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> CSV",
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SQL",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> XLS2022",
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> XLS2023",
				"CSV select(mapColumn(",
				"          ParadaHistoricaId = nro_parada,",
				"          NombreParada = nombre_parada,",
				"          Zona = zona,",
				"          Latitud = latitud,",
				"          Longitud = longitud,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"XLS2022 select(mapColumn(",
				"          ParadaHistoricaId = nro_parada,",
				"          NombreParada = nombre_parada,",
				"          Zona = zona,",
				"          Latitud = latitud,",
				"          Longitud = longitud,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"XLS2023 select(mapColumn(",
				"          ParadaHistoricaId = nro_parada,",
				"          NombreParada = nombre_parada,",
				"          Zona = zona,",
				"          Latitud = latitud,",
				"          Longitud = longitud,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, SQL union(byName: true)~> union1",
				"union1, select2 union(byName: true)~> union2",
				"union2, select3 union(byName: true)~> union3",
				"union3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}