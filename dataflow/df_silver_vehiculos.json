{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "bronze"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "unifomarvehiculoid"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronze",
				"bronze derive(AnioFuente = trim(AnioFuente),",
				"          VehiculoId = trim(VehiculoId),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          CapacidadEfectiva = trim(CapacidadEfectiva),",
				"          VigenciaDesde = trim(VigenciaDesde),",
				"          VigenciaHasta = trim(VigenciaHasta),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 derive(VehiculoId = concat('V-', lpad(replace(upper(VehiculoId), 'V-', ''), 3, '0'))) ~> unifomarvehiculoid",
				"unifomarvehiculoid derive(AnioFuente = toInteger(AnioFuente),",
				"          CapacidadEfectiva = toInteger(CapacidadEfectiva),",
				"          VigenciaDesde = coalesce(toDate(VigenciaDesde, 'dd/MM/yyyy'), toDate(VigenciaDesde, 'yyyy-MM-dd')),",
				"          VigenciaHasta = coalesce(toDate(VigenciaHasta, 'dd/MM/yyyy'), toDate(VigenciaHasta, 'yyyy-MM-dd'))) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(AnioFuente) && !isNull(VehiculoId) && !isNull(Placa) && !isNull(TipoVehiculo) && !isNull(CapacidadEfectiva) && !isNull(VigenciaDesde) && !isNull(VigenciaHasta) && !isNull(Estado) && Placa != '' && TipoVehiculo != '' && Estado != '') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}